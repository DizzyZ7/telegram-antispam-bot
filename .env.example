# Copy to .env for local/Bothost file-based configuration.
# Never commit real credentials.
BOT_TOKEN=
ALLOWED_CHATS=
WRITERS_CHAT_ID=-1002619489118
ENTERTAINMENT_CHAT_IDS=-1002619489118

# PostgreSQL is required while Zero Trust protects at least one chat and is also
# preferred for Entertainment persistence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Writers Submission v1 is disabled by default. Enable only after configuring
# the public HTTPS Mini App URL, private moderation/file-storage chats and the
# Telegram user IDs allowed to moderate.
WRITERS_SUBMISSION_ENABLED=0
WRITERS_SUBMISSION_PUBLIC_URL=https://example.invalid/writers/
WRITERS_SUBMISSION_MOD_CHAT_ID=-1000000000001
WRITERS_SUBMISSION_FILE_CHAT_ID=-1000000000002
WRITERS_SUBMISSION_MODERATOR_IDS=123456789
# The approved publication draft goes to this owner's private Telegram chat ONLY.
WRITERS_SUBMISSION_OWNER_USER_ID=2039781854
WRITERS_SUBMISSION_BIND_HOST=0.0.0.0
WRITERS_SUBMISSION_PORT=8080
WRITERS_SUBMISSION_INIT_DATA_MAX_AGE_SECONDS=900
WRITERS_SUBMISSION_SESSION_TTL_SECONDS=43200
WRITERS_SUBMISSION_MAX_FILE_BYTES=20971520
WRITERS_SUBMISSION_MAX_FILES=3
WRITERS_SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60

# Zero Trust v2 security scope is intentionally independent from ALLOWED_CHATS.
# Every human rejoin gets a fresh per-chat challenge; completed sessions remain
# in PostgreSQL history. Leave ZERO_TRUST_CHAT_IDS empty only to explicitly turn
# entry verification off for every chat.
ZERO_TRUST_CHAT_IDS=-1002619489118,-1003237014529,-1003643412493,-1003687304800
ZERO_TRUST_CHALLENGE_TTL_SECONDS=300

# Long-term memory keeps up to about 100k raw events per forum topic.
# Generation reads only a bounded recent sample plus small historical windows,
# so large history does not make every generation request expensive. Pruning
# happens in batches after the buffer is exceeded.
ENTERTAINMENT_MEMORY_LIMIT=100000
ENTERTAINMENT_GENERATION_SAMPLE_LIMIT=1500
ENTERTAINMENT_MEMORY_PRUNE_BUFFER=1000

# Chat-only language engine. v3 is the default and learns only from the allowed
# same-topic Culture Memory/context supplied by Entertainment. Set v2 for the
# temporary one-release rollback path; no external corpora or AI APIs are used.
ENTERTAINMENT_GENERATION_ENGINE=v3

# Bootstrap culture learning. Before this many TEXT+EMOJI events in a topic,
# commands and messages from other bots can influence local culture normally;
# afterward their influence is reduced while the events remain remembered.
ENTERTAINMENT_BOOTSTRAP_TEXT_EVENT_THRESHOLD=10000

# Do not autonomously reuse the same Telegram media file_unique_id in the same
# chat/topic more often than this many seconds (default: 6 hours).
ENTERTAINMENT_MEDIA_REPEAT_COOLDOWN_SECONDS=21600

# Keep disabled in production unless you explicitly accept split-brain fallback.
ENTERTAINMENT_DB_FALLBACK_SQLITE=0

DATA_DIR=./data
SUMMARY_TIMEZONE=Europe/Moscow
