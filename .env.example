# Copy to .env for local/Bothost file-based configuration.
# Never commit real credentials.
BOT_TOKEN=
ALLOWED_CHATS=
WRITERS_CHAT_ID=-1002619489118
ENTERTAINMENT_CHAT_IDS=-1002619489118

# PostgreSQL is preferred for Entertainment persistence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Keep disabled in production unless you explicitly accept split-brain fallback.
ENTERTAINMENT_DB_FALLBACK_SQLITE=0

DATA_DIR=./data
SUMMARY_TIMEZONE=Europe/Moscow
